---
import Base from '../../layouts/Base.astro';
import DetailPage from '../../components/DetailPage.astro';
import { productPages } from '../../data/pages';
import { detailGraph } from '../../data/schema';

export function getStaticPaths() {
  return productPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---

<Base title={page.seoTitle} description={page.description} schema={detailGraph(page, page.seoTitle)}>
  <DetailPage page={page} />
</Base>
