---
import { services } from '../data/services';
import { contactUrl, contactLinkAttrs } from '../data/site';
import SectionHead from './SectionHead.astro';
import Icons from './Icons.astro';
---

<section id="layanan" class="container-x scroll-mt-[var(--nav-h)] py-24 sm:py-32 lg:py-40">
  <SectionHead
    index="01"
    eyebrow="Layanan"
    title="Semua yang bisnis Anda butuhkan,"
    italic="dalam satu tim."
    lead="Jasa pembuatan website, aplikasi mobile Android & iOS, sistem bisnis terintegrasi, hingga konsultasi dan implementasi AI — dikerjakan tim Innaka Tech di Bekasi untuk bisnis di seluruh Indonesia."
    class="mb-14 lg:mb-24"
  />

  <div class="relative flex flex-col gap-5 lg:gap-6" id="stack">
    {
      services.map((s, i) => (
        <article
          class="stack-card overflow-hidden rounded-3xl border border-line bg-ink-2 p-6 sm:p-10 lg:p-14"
          style={`z-index:${i + 1}`}
          id={s.id}
          data-stack-card
        >
          <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
            <div class="flex flex-col lg:col-span-5">
              <div class="mb-6 flex items-center gap-4">
                <span class="font-mono text-[11px] text-accent">{s.index}</span>
                <span class="h-px w-8 bg-line" />
                <span class="eyebrow">{s.eyebrow}</span>
              </div>
              <h3 class="display t-card max-w-[16ch]">{s.title}</h3>
              <p class="mt-5 max-w-[40ch] text-[16px] leading-relaxed text-muted lg:text-[17px]">{s.summary}</p>
              <a
                href={contactUrl(`Halo Innaka, saya ingin diskusi tentang ${s.title}.`, `Diskusi: ${s.title}`)}
                {...contactLinkAttrs}
                class="group/cta mt-8 inline-flex w-fit items-center gap-3 text-[15px] font-medium text-paper lg:mt-auto lg:pt-10"
                data-cursor="hide"
              >
                <span class="link-ul">Diskusikan kebutuhan ini</span>
                <span class="grid h-8 w-8 place-items-center rounded-full border border-line transition-colors duration-300 group-hover/cta:border-accent group-hover/cta:bg-accent group-hover/cta:text-ink">
                  <Icons name="arrow" class="h-3.5 w-3.5" />
                </span>
              </a>
            </div>
            <ul class="border-t border-line lg:col-span-7">
              {s.items.map((it, j) => (
                <li class="group flex items-start gap-5 border-b border-line py-5 last:border-b-0 sm:gap-8">
                  <span class="mt-1 w-6 shrink-0 font-mono text-[11px] text-paper/35 transition-colors duration-300 group-hover:text-accent">
                    {String(j + 1).padStart(2, '0')}
                  </span>
                  <div class="flex min-w-0 flex-col gap-1">
                    <span class="flex flex-wrap items-center gap-3 text-[17px] font-medium tracking-tight transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1 lg:text-[19px]">
                      {it.title}
                      {it.soon && (
                        <span class="rounded-full border border-accent/40 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.14em] text-accent">
                          Segera hadir
                        </span>
                      )}
                    </span>
                    <span class="text-[15px] leading-relaxed text-muted">{it.desc}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
