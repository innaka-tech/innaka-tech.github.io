---
import { services } from '../data/services';
import SectionHead from './SectionHead.astro';
import Icons from './Icons.astro';
---

<section id="layanan" class="container-x scroll-mt-[var(--nav-h)] py-24 sm:py-32 lg:py-40">
  <SectionHead index="01" eyebrow="Layanan" title="Semua yang bisnis Anda butuhkan," italic="dalam satu tim." class="mb-16 lg:mb-24" />

  <div class="relative flex flex-col gap-6" id="stack">
    {
      services.map((s, i) => (
        <article
          class="stack-card rounded-3xl border border-line bg-ink-2 p-6 sm:p-10 lg:p-14"
          style={`--i:${i}; z-index:${i + 1}`}
          id={s.id}
          data-stack-card
        >
          <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-5">
              <div class="mb-6 flex items-center gap-4">
                <span class="font-mono text-[11px] text-accent">{s.index}</span>
                <span class="eyebrow">{s.eyebrow}</span>
              </div>
              <h3 class="display text-[8.5vw] sm:text-[5.5vw] lg:text-[2.9vw]">{s.title}</h3>
              <p class="mt-6 max-w-[40ch] text-[16px] leading-relaxed text-muted lg:text-[17px]">{s.summary}</p>
            </div>
            <ul class="divide-y divide-line border-t border-line lg:col-span-7">
              {s.items.map((it) => (
                <li class="group flex items-start justify-between gap-6 py-5 transition-colors">
                  <div class="flex min-w-0 flex-col gap-1">
                    <span class="flex flex-wrap items-center gap-3 text-[17px] font-medium tracking-tight lg:text-[19px]">
                      {it.title}
                      {it.soon && (
                        <span class="rounded-full border border-accent/40 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.14em] text-accent">
                          Segera hadir
                        </span>
                      )}
                    </span>
                    <span class="text-[15px] text-muted">{it.desc}</span>
                  </div>
                  <span class="mt-1 shrink-0 text-paper/30 transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1 group-hover:text-accent">
                    <Icons name="arrow" class="h-4 w-4" />
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
