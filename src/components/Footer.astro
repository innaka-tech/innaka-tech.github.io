---
import { site, companyName } from '../data/site';
import Icons from './Icons.astro';
import Logo from './Logo.astro';
import { servicePages, productPages, pageUrl } from '../data/pages';
import horizontalDark from '../assets/brand/innaka-horizontal-dark.svg?raw';

// Path wordmark "innaka" dari logo resmi — dipakai untuk wordmark raksasa di footer.
const wordmarkPath = horizontalDark.match(/<path d="([^"]+)"/)?.[1] ?? '';

const year = new Date().getFullYear();
const isHome = Astro.url.pathname === '/';
const p = isHome ? '' : '/';
const company = [
  { href: `${p}#kenapa`, label: 'Kenapa Innaka' },
  { href: `${p}#proses`, label: 'Cara Kerja' },
  { href: `${p}#faq`, label: 'FAQ' },
  { href: `${p}#kontak`, label: 'Kontak' },
];
const serviceLinks = servicePages.map((sp) => ({ href: pageUrl(sp), label: sp.name }));
const productLinks = productPages.map((pp) => ({ href: pageUrl(pp), label: pp.name }));

const socials = [
  { href: site.social.instagram, label: 'Instagram' },
  { href: site.social.linkedin, label: 'LinkedIn' },
  { href: site.social.github, label: 'GitHub' },
];
---

<footer class="border-t border-line">
  <div class="container-x grid gap-12 py-14 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-5">
      <a href={isHome ? '#top' : '/'} class="inline-flex" data-cursor="small" aria-label={`${companyName} — beranda`}>
        <Logo decorative class="h-9" />
      </a>
      <p class="mt-6 max-w-[44ch] text-[15px] leading-relaxed text-muted">{site.about}</p>
    </div>

    <div class="grid grid-cols-2 gap-x-8 gap-y-10 lg:col-span-7 lg:grid-cols-4">
      <nav aria-label="Layanan">
        <p class="eyebrow mb-5">Layanan</p>
        <ul class="flex flex-col gap-3">
          {serviceLinks.map((l) => <li><a href={l.href} class="link-ul text-[15px] text-paper/80 hover:text-paper" data-cursor="small">{l.label}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Produk & perusahaan">
        <p class="eyebrow mb-5">Produk</p>
        <ul class="flex flex-col gap-3">
          {productLinks.map((l) => <li><a href={l.href} class="link-ul text-[15px] text-paper/80 hover:text-paper" data-cursor="small">{l.label}</a></li>)}
        </ul>
        <p class="eyebrow mb-5 mt-10">Perusahaan</p>
        <ul class="flex flex-col gap-3">
          {company.map((l) => <li><a href={l.href} class="link-ul text-[15px] text-paper/80 hover:text-paper" data-cursor="small">{l.label}</a></li>)}
        </ul>
      </nav>
      <div class="col-span-2">
        <p class="eyebrow mb-5">Kontak</p>
        <ul class="flex flex-col gap-3 text-[15px] text-paper/80">
          <li><a href={`mailto:${site.email}`} class="link-ul" data-cursor="small">{site.email}</a></li>
          <li><a href={`tel:+${site.whatsapp}`} class="link-ul" data-cursor="small">{site.phone}</a></li>
          <li>
            <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-[14px] leading-relaxed text-muted transition-colors hover:text-paper" data-cursor="small">
              {site.addressFull.street}, {site.addressFull.city}, {site.addressFull.region} {site.addressFull.postalCode}
            </a>
          </li>
        </ul>
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
          {socials.map((l) => <li><a href={l.href} target="_blank" rel="noopener" class="link-ul text-[14px] text-paper/80 hover:text-paper" data-cursor="small">{l.label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>

  <div class="container-x flex flex-col gap-3 border-t border-line py-6 text-[12px] text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {companyName}.{site.nib && ` NIB ${site.nib}.`} Hak cipta dilindungi.</p>
    <a href="#top" class="group inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.14em] text-paper/70 hover:text-paper" data-cursor="small">
      Kembali ke atas
      <span class="grid h-8 w-8 place-items-center rounded-full border border-line transition-colors duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-ink">
        <Icons name="arrow-right" class="h-3.5 w-3.5 -rotate-90" />
      </span>
    </a>
  </div>

  <!-- Wordmark raksasa (path resmi dari logo) -->
  <div class="container-x overflow-hidden pt-6" aria-hidden="true">
    <svg class="footer-word block w-full" viewBox="114.8 35.18 142.99 35.38" data-footer-word>
      <defs>
        <linearGradient id="footer-word-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f8fafc" stop-opacity="0.1" />
          <stop offset="0.9" stop-color="#f8fafc" stop-opacity="0.015" />
        </linearGradient>
      </defs>
      <path d={wordmarkPath} fill="url(#footer-word-fill)" />
    </svg>
  </div>
</footer>

