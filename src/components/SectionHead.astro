---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  /** Bagian judul yang ditampilkan italic serif */
  italic?: string;
  class?: string;
  /** Paragraf pengantar di bawah judul (opsional) */
  lead?: string;
}
const { index, eyebrow, title, italic, class: cls = '', lead } = Astro.props;
---

<div class={`grid gap-6 lg:grid-cols-12 ${cls}`}>
  <div class="flex items-center gap-4 lg:col-span-3" data-reveal>
    <span class="font-mono text-[11px] text-accent">({index})</span>
    <span class="eyebrow">{eyebrow}</span>
  </div>
  <h2 class="display t-section lg:col-span-9" data-split>
    {title}
    {italic && <span class="serif-italic text-paper-2">{italic}</span>}
  </h2>
  {lead && <p class="max-w-[58ch] text-[17px] leading-relaxed text-muted lg:col-span-6 lg:col-start-4" data-reveal>{lead}</p>}
</div>
