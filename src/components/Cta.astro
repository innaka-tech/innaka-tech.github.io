---
import { site, contactUrl, contactLinkAttrs, hasWhatsapp } from '../data/site';
import Icons from './Icons.astro';

const assurances = [
  'Konsultasi awal gratis, tanpa komitmen',
  'Estimasi transparan, tanpa biaya tersembunyi',
  'Data dan kode sepenuhnya milik Anda',
];
---

<section id="kontak" class="relative isolate scroll-mt-[var(--nav-h)] overflow-hidden border-t border-line py-28 sm:py-36 lg:py-44">
  <div
    class="cta-orb pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[90vmax] w-[90vmax] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-50 blur-3xl"
    style="background: radial-gradient(closest-side, rgba(201,242,76,0.16), transparent 70%)"
    aria-hidden="true"
  >
  </div>

  <div class="container-x">
    <div class="mb-8 flex items-center gap-4" data-reveal>
      <span class="font-mono text-[11px] text-accent">(06)</span>
      <span class="eyebrow">Mulai dari percakapan</span>
    </div>
    <h2 class="display t-cta leading-[0.9]" data-split>
      Ceritakan <span class="serif-italic text-accent">masalahnya,</span><br class="hidden sm:block" />
      kami yang pikirkan solusinya.
    </h2>

    <div class="mt-12 grid gap-12 border-t border-line pt-10 lg:mt-16 lg:grid-cols-12 lg:gap-12 lg:pt-14">
      <!-- Kanal kontak langsung -->
      <div class="flex flex-col gap-8 lg:col-span-5" data-reveal>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={contactUrl()} {...contactLinkAttrs} class="btn btn-primary !px-7 !py-4 !text-[16px]" data-magnetic data-cursor="hide">
            <Icons name={hasWhatsapp ? 'whatsapp' : 'mail'} class="h-5 w-5" />
            {hasWhatsapp ? 'Chat via WhatsApp' : 'Kirim email'}
            <span class="btn-arrow"><Icons name="arrow" class="h-3.5 w-3.5" /></span>
          </a>
          {
            hasWhatsapp && (
              <a href={`mailto:${site.email}`} class="btn btn-ghost !px-7 !py-4 !text-[16px]" data-magnetic data-cursor="hide">
                <Icons name="mail" class="h-5 w-5" />
                Email
              </a>
            )
          }
        </div>

        <ul class="flex flex-col gap-3.5">
          {
            assurances.map((a) => (
              <li class="flex items-center gap-3 text-[15px] text-paper/80">
                <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-accent/15 text-accent">
                  <svg class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="m3.5 8.5 3 3 6-7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                {a}
              </li>
            ))
          }
        </ul>

        <dl class="grid gap-6 border-t border-line pt-8 text-[15px] sm:grid-cols-2">
          <div>
            <dt class="eyebrow mb-2">Telepon / WhatsApp</dt>
            <dd><a href={`tel:+${site.whatsapp}`} class="link-ul text-paper" data-cursor="small">{site.phone}</a></dd>
          </div>
          <div>
            <dt class="eyebrow mb-2">Email</dt>
            <dd><a href={`mailto:${site.email}`} class="link-ul text-paper" data-cursor="small">{site.email}</a></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="eyebrow mb-2">Kantor</dt>
            <dd>
              <a href={site.mapsUrl} target="_blank" rel="noopener" class="group inline-flex items-start gap-2 text-paper/80 hover:text-paper" data-cursor="small">
                <span>
                  {site.addressFull.street},<br />
                  {site.addressFull.city}, {site.addressFull.region} {site.addressFull.postalCode}
                </span>
                <Icons name="arrow" class="mt-1 h-3.5 w-3.5 shrink-0 text-paper/40 transition-colors group-hover:text-accent" />
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <!-- Form -->
      <form
        class="grid gap-6 rounded-3xl border border-line bg-ink-2/60 p-6 backdrop-blur-sm sm:p-8 lg:col-span-6 lg:col-start-7"
        action="https://api.web3forms.com/submit"
        method="POST"
        data-reveal
        data-reveal-delay="0.15"
        id="contact-form"
        data-email={site.email}
      >
        <div>
          <p class="text-[19px] font-medium tracking-tight">Atau tinggalkan pesan</p>
          <p class="mt-1 text-[14px] text-muted">Kami balas dalam 1 hari kerja.</p>
        </div>
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="subject" value={`Pesan baru dari website ${site.name}`} />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
        <div class="grid gap-6 sm:grid-cols-2">
          <label class="flex flex-col gap-2">
            <span class="eyebrow">Nama</span>
            <input required name="name" type="text" autocomplete="name" class="field" placeholder="Nama Anda" />
          </label>
          <label class="flex flex-col gap-2">
            <span class="eyebrow">Email / WhatsApp</span>
            <input required name="contact" type="text" class="field" placeholder="email atau 08xx" />
          </label>
        </div>
        <label class="flex flex-col gap-2">
          <span class="eyebrow">Ceritakan kebutuhan Anda</span>
          <textarea required name="message" rows="4" class="field resize-none" placeholder="Contoh: saya punya 3 toko dan ingin stoknya terhubung…"></textarea>
        </label>
        <div class="flex flex-col-reverse gap-4 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-[13px] text-muted" id="form-status" role="status" aria-live="polite"></p>
          <button type="submit" class="btn btn-primary sm:shrink-0" data-magnetic data-cursor="hide">
            Kirim pesan
            <span class="btn-arrow"><Icons name="arrow" class="h-3.5 w-3.5" /></span>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .field {
    border-bottom: 1px solid var(--color-line);
    background: transparent;
    padding: 0.7rem 0;
    font-size: 16px;
    outline: none;
    transition: border-color 0.3s;
  }
  .field::placeholder {
    color: rgba(243, 240, 232, 0.35);
  }
  .field:focus {
    border-color: var(--color-accent);
  }
  .field:focus-visible {
    outline: none;
  }
</style>
