---
import { products } from '../data/services';
import { contactUrl, contactLinkAttrs } from '../data/site';
import Icons from './Icons.astro';

const demoUrl = (name: string) => contactUrl(`Halo Innaka, saya ingin minta demo ${name}.`, `Permintaan demo ${name}`);

const posItems = [
  { name: 'Kopi Susu Aren', qty: 2, price: '44.000' },
  { name: 'Croissant Butter', qty: 1, price: '32.000' },
  { name: 'Air Mineral', qty: 3, price: '18.000' },
];

// Peta rak: nilai = tingkat isi 0–3
const racks = [
  3, 2, 3, 1, 0, 2, 3, 3,
  2, 3, 1, 2, 3, 3, 2, 0,
  3, 1, 2, 3, 2, 1, 3, 2,
];
const rackColor = ['rgba(243,240,232,0.06)', 'rgba(255,179,107,0.25)', 'rgba(255,179,107,0.55)', 'var(--color-accent-2)'];
---

<section id="produk" class="scroll-mt-[var(--nav-h)] bg-paper py-24 text-ink sm:py-32 lg:py-40" data-theme-light>
  <div class="container-x">
    <div class="grid gap-6 lg:grid-cols-12">
      <div class="flex items-center gap-4 lg:col-span-3" data-reveal>
        <span class="font-mono text-[11px] text-ink/60">(02)</span>
        <span class="eyebrow !text-ink/60">Software siap pakai</span>
      </div>
      <h2 class="display t-section lg:col-span-9" data-split>
        Pasang hari ini, <span class="serif-italic text-ink/70">jalan hari ini.</span>
      </h2>
    </div>

    <div class="mt-14 grid gap-5 lg:mt-24 lg:grid-cols-2 lg:gap-6" data-reveal-stagger>
      {
        products.map((p, i) => (
          <article class="product-card group relative flex flex-col overflow-hidden rounded-3xl bg-ink p-6 text-paper sm:p-10" id={p.id}>
            <div
              class="pointer-events-none absolute -right-1/4 -top-1/4 h-[80%] w-[80%] rounded-full opacity-40 blur-3xl transition-transform duration-[1200ms] ease-[var(--ease-out-expo)] group-hover:scale-125"
              style={`background: radial-gradient(closest-side, ${p.accent}, transparent 70%)`}
              aria-hidden="true"
            />
            <div class="relative">
              <div class="flex items-center justify-between">
                <span class="eyebrow">{p.tag}</span>
                <span class="font-mono text-[11px] text-paper/40">0{i + 1}</span>
              </div>
              <h3 class="display t-product mt-8">{p.name}</h3>
              <p class="serif-italic mt-3 text-[22px] leading-tight text-paper/80 sm:text-[26px]">{p.headline}</p>
              <p class="mt-5 max-w-[44ch] text-[16px] leading-relaxed text-muted">{p.desc}</p>
            </div>

            {/* Mockup UI (ilustrasi) */}
            <div class="mockup relative mt-8 rounded-2xl border border-line bg-ink-2 p-4 transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:-translate-y-1 sm:p-5" aria-hidden="true" data-mockup>
              <div class="mb-4 flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                  <span class="h-2 w-2 rounded-full bg-paper/15" />
                  <span class="h-2 w-2 rounded-full bg-paper/15" />
                  <span class="h-2 w-2 rounded-full bg-paper/15" />
                </div>
                <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-paper/40">
                  {p.id === 'tokopilot' ? 'Kasir 01 · Cabang Utama' : 'Gudang A · Zona R'}
                </span>
              </div>

              {p.id === 'tokopilot' ? (
                <div class="grid gap-4 sm:grid-cols-[1.4fr_1fr]">
                  <ul class="space-y-2">
                    {posItems.map((it) => (
                      <li class="mock-row flex items-center justify-between rounded-lg bg-paper/[0.04] px-3 py-2.5 text-[13px]">
                        <span class="flex items-center gap-2.5">
                          <span class="grid h-5 w-5 place-items-center rounded-md bg-accent/15 font-mono text-[10px] text-accent">{it.qty}</span>
                          {it.name}
                        </span>
                        <span class="font-mono text-[12px] text-paper/60">{it.price}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mock-row flex flex-col justify-between rounded-xl border border-line p-3.5">
                    <div>
                      <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-paper/40">Total</p>
                      <p class="mt-1 text-[24px] font-medium tracking-tight">Rp 94.000</p>
                    </div>
                    <span class="mt-3 flex items-center justify-center gap-2 rounded-lg bg-accent py-2 text-[13px] font-medium text-ink">
                      Bayar · QRIS
                    </span>
                  </div>
                </div>
              ) : (
                <div class="grid gap-4 sm:grid-cols-[1.4fr_1fr]">
                  <div>
                    <div class="grid grid-cols-8 gap-1.5">
                      {racks.map((v) => (
                        <span class="mock-cell aspect-square rounded-[5px]" style={`background:${rackColor[v]}`} />
                      ))}
                    </div>
                    <div class="mt-3 flex items-center gap-3 font-mono text-[10px] text-paper/40">
                      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm" style={`background:${rackColor[3]}`} />Penuh</span>
                      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm" style={`background:${rackColor[1]}`} />Rendah</span>
                      <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm" style={`background:${rackColor[0]}`} />Kosong</span>
                    </div>
                  </div>
                  <ul class="space-y-2 text-[12px]">
                    <li class="mock-row rounded-lg bg-paper/[0.04] px-3 py-2.5">
                      <p class="flex justify-between"><span>Inbound PO-2291</span><span class="text-accent-2">✓</span></p>
                      <p class="mt-0.5 font-mono text-[10px] text-paper/40">48 pcs · Rak R-03</p>
                    </li>
                    <li class="mock-row rounded-lg bg-paper/[0.04] px-3 py-2.5">
                      <p class="flex justify-between"><span>Outbound SO-0817</span><span class="text-paper/50">→</span></p>
                      <p class="mt-0.5 font-mono text-[10px] text-paper/40">12 paket · siap pickup</p>
                    </li>
                  </ul>
                </div>
              )}
            </div>

            <div class="relative mt-8 flex flex-1 flex-col justify-end">
              <ul class="grid grid-cols-1 gap-y-3 border-t border-line pt-6 sm:grid-cols-2 sm:gap-x-6">
                {p.features.map((f) => (
                  <li class="flex items-center gap-3 text-[15px]">
                    <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background:${p.accent}`} />
                    {f}
                  </li>
                ))}
              </ul>
              <div class="mt-8">
                <a href={demoUrl(p.name)} {...contactLinkAttrs} class="btn btn-primary" data-magnetic data-cursor="hide">
                  Minta Demo {p.name.split(' ')[0]}
                  <span class="btn-arrow">
                    <Icons name="arrow" class="h-3.5 w-3.5" />
                  </span>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
