---
import { reasons } from '../data/services';
import SectionHead from './SectionHead.astro';
---

<section id="kenapa" class="container-x scroll-mt-[var(--nav-h)] py-24 sm:py-32 lg:py-40">
  <SectionHead index="03" eyebrow="Kenapa Innaka" title="Dibangun untuk" italic="bisnis yang serius tumbuh." class="mb-14 lg:mb-24" />

  <div class="grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
    {
      reasons.map((r, i) => (
        <div class="why-card group relative flex flex-col bg-ink p-7 transition-colors duration-500 hover:bg-ink-2 sm:p-8">
          <span class="absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-accent transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-x-100" aria-hidden="true" />
          <div class="flex items-start justify-between">
            <span class="grid h-12 w-12 place-items-center rounded-2xl border border-line text-accent transition-colors duration-500 group-hover:border-accent/40 group-hover:bg-accent/10">
              {r.icon === 'stack' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="m12 3 9 5-9 5-9-5 9-5Z" stroke-linejoin="round" />
                  <path d="m3 13 9 5 9-5" stroke-linejoin="round" />
                </svg>
              )}
              {r.icon === 'users' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <circle cx="9" cy="8" r="3.5" />
                  <path d="M2.5 20c.8-3.4 3.4-5.5 6.5-5.5s5.7 2.1 6.5 5.5" stroke-linecap="round" />
                  <path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.8c1.8.8 3 2.6 3.5 5.2" stroke-linecap="round" />
                </svg>
              )}
              {r.icon === 'growth' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M3 17 9 11l4 4 8-8" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M15 7h6v6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {r.icon === 'pin' && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21Z" stroke-linejoin="round" />
                  <circle cx="12" cy="9.5" r="2.5" />
                </svg>
              )}
            </span>
            <span class="font-mono text-[11px] text-paper/30">0{i + 1}</span>
          </div>
          <div class="mt-12 lg:mt-16">
            <h3 class="text-[21px] font-medium tracking-tight lg:text-[22px]">{r.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-muted">{r.desc}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
