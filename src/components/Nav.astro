---
import { site, contactUrl, contactLinkAttrs, hasWhatsapp } from '../data/site';
import Icons from './Icons.astro';
import Logo from './Logo.astro';

const links = [
  { href: '#layanan', label: 'Layanan' },
  { href: '#produk', label: 'Produk' },
  { href: '#proses', label: 'Cara Kerja' },
  { href: '#faq', label: 'FAQ' },
  { href: '#kontak', label: 'Kontak' },
];
---

<header id="nav" class="fixed inset-x-0 top-0 z-50 transition-transform duration-500 ease-[var(--ease-out-expo)]">
  <div class="nav-bg absolute inset-0 -z-10 border-b border-transparent bg-ink/0 backdrop-blur-0 transition-all duration-500"></div>
  <span class="nav-progress absolute bottom-0 left-0 h-px w-full origin-left scale-x-0 bg-accent" aria-hidden="true"></span>
  <nav class="container-x flex h-[var(--nav-h)] items-center justify-between" aria-label="Utama">
    <a href="#top" class="flex items-center" data-cursor="small" aria-label={`${site.legalName || site.name} — beranda`}>
      <Logo tone="auto" decorative class="h-8 lg:h-10" />
    </a>

    <ul class="hidden items-center gap-1 rounded-full border border-line p-1 md:flex" id="nav-links">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="nav-link block rounded-full px-4 py-1.5 text-[14px] text-paper/70 transition-colors duration-300 hover:text-paper"
              data-cursor="small"
              data-section={l.href.slice(1)}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a href={contactUrl()} {...contactLinkAttrs} class="btn btn-primary hidden !py-2.5 text-[14px] lg:inline-flex" data-magnetic data-cursor="hide">
        Konsultasi Gratis
        <span class="btn-arrow"><Icons name="arrow" class="h-3.5 w-3.5" /></span>
      </a>
      <button
        id="menu-btn"
        class="relative grid h-11 w-11 place-items-center rounded-full border border-line md:hidden"
        aria-label="Buka menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-line absolute h-px w-5 bg-paper transition-transform duration-500 ease-[var(--ease-out-expo)] -translate-y-[3px]"></span>
        <span class="menu-line absolute h-px w-5 bg-paper transition-transform duration-500 ease-[var(--ease-out-expo)] translate-y-[3px]"></span>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="pointer-events-none fixed inset-0 z-40 flex flex-col justify-end bg-ink px-5 pb-10 pt-[var(--nav-h)] opacity-0 transition-opacity duration-500 md:hidden"
  aria-hidden="true"
>
  <ul class="flex flex-col gap-2">
    {
      links.map((l, i) => (
        <li class="menu-item overflow-hidden">
          <a href={l.href} class="display block translate-y-full py-1 text-[13vw] transition-transform duration-700 ease-[var(--ease-out-expo)]" style={`transition-delay:${80 + i * 60}ms`}>
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mt-10 flex flex-col gap-4 border-t border-line pt-8">
    <a href={contactUrl()} {...contactLinkAttrs} class="btn btn-primary w-full">
      {hasWhatsapp ? 'Konsultasi Gratis via WhatsApp' : 'Konsultasi Gratis via Email'}
    </a>
    <a href={`mailto:${site.email}`} class="eyebrow text-center">{site.email}</a>
  </div>
</div>
